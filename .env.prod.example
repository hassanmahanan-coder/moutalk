# 生产环境变量模板（复制为 .env.prod 并填入真实值，勿提交仓库）
APP_NAME=moutalk
APP_ENV=prod
DEBUG=false
SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=1440

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=moutalk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=moutalk

REDIS_URL=redis://redis:6379/0
MILVUS_URI=http://milvus-standalone:19530
EMBEDDING_MODEL_PATH=/models/bge-small-zh-v1.5
RERANKER_MODEL_PATH=/models/bge-reranker-base

LLM_BASE_URL=CHANGE_ME
LLM_API_KEY=CHANGE_ME
LLM_MODEL=deepseek-v4-flash
LLM_LIGHT_MODEL=deepseek-v4-flash
LLM_STREAM=true

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

SMTP_HOST=CHANGE_ME
SMTP_PORT=465
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=CHANGE_ME

ALIPAY_APP_ID=CHANGE_ME
ALIPAY_PRIVATE_KEY=CHANGE_ME
ALIPAY_PUBLIC_KEY=CHANGE_ME
ALIPAY_NOTIFY_URL=https://moutalk.example.com/api/payment/notify
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

LANGFUSE_PUBLIC_KEY=CHANGE_ME
LANGFUSE_SECRET_KEY=CHANGE_ME
LANGFUSE_HOST=https://cloud.langfuse.com
