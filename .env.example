# ============================================================
# 谋谈 (MouTalk) 环境变量模板
# 复制为 .env 并填入真实值。禁止将 .env 提交到仓库。
# ============================================================

# ---------- 应用 ----------
APP_NAME=moutalk
APP_ENV=dev                 # dev / staging / prod
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440     # 24h

# ---------- 数据库 ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=moutalk
POSTGRES_PASSWORD=moutalk_dev_pw
POSTGRES_DB=moutalk
DATABASE_URL=postgresql+psycopg://moutalk:moutalk_dev_pw@localhost:5432/moutalk

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- 向量记忆 ----------
# dev: 使用 Milvus Lite (本地文件), 如 milvus:///./milvus.db
# prod: 使用完整 Milvus, 如 milvus://localhost:19530
MILVUS_URI=milvus:///./milvus.db
EMBEDDING_BACKEND=local_cpu     # local_cpu | http
RERANKER_BACKEND=local_cpu      # local_cpu | http

# ---------- LLM (OpenAI 兼容) ----------
# 智谱 GLM: https://open.bigmodel.cn/api/paas/v4/
# 或任何 OpenAI 兼容网关地址
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=
LLM_MODEL=glm-4-plus
LLM_LIGHT_MODEL=glm-4-flash     # 意图解析/战术兜底等轻量任务
LLM_STREAM=true

# ---------- Celery ----------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- SMTP (邮箱验证) ----------
# 开发期留空则使用控制台打印验证码模式
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- 支付 (开发期用沙箱) ----------
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=

# ---------- 可观测 ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
